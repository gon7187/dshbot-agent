{
  "name": "dshbot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "node --import ./packages/app/register.mjs ./packages/app/src/main.ts",
    "typecheck": "tsc --noEmit",
    "gate": "npm run typecheck && vitest related --run --passWithNoTests",
    "test": "npm run typecheck && vitest run",
    "bench:runner": "node --import ./packages/runner/bench/register.mjs ./packages/runner/bench/bench.ts",
    "bench:write": "node --import ./packages/runner/bench/register.mjs ./packages/runner/bench/bench.ts --write",
    "bench:daemon": "node --import ./packages/runner/bench/register.mjs ./packages/runner/bench/daemon.ts",
    "bench:daemon:write": "node --import ./packages/runner/bench/register.mjs ./packages/runner/bench/daemon.ts --write"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@audio/decode-mp3": "1.3.1",
    "@audio/decode-mp4": "1.3.1",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.3",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.3",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.1-rc.3",
