#!/usr/bin/env node
// Send one text to the daemon's local /notify endpoint.
//
//   scripts/dshbot-send "диск заполнен"
//   df -h | scripts/dshbot-send
//
// The token and the port come from DSHBOT_NOTIFY_TOKEN and DSHBOT_NOTIFY_PORT,
// the same variables the daemon reads. The text is the command-line arguments
// joined by a space, or all of stdin when there are no arguments. A non-200
// answer is an error: the exit code is 1 and stderr names the status.

import { request } from 'node:http'

const HOST = '127.0.0.1'
const PATH = '/notify'
const REQUEST_TIMEOUT_MS = 30_000

function fail(message) {
  process.stderr.write(`dshbot-send: ${message}\n`)
  process.exitCode = 1
}

function readStdin() {
  return new Promise((resolve, reject) => {
    const chunks = []
    process.stdin.on('data', (chunk) => chunks.push(Buffer.from(chunk)))
    process.stdin.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')))
    process.stdin.on('error', reject)
  })
}

function textFromArgs(args) {
  return args.join(' ')
}

function post(port, token, text) {
  return new Promise((resolve, reject) => {
    const url = `http://${HOST}:${port}${PATH}`
    const req = request(
      url,
      {
        method: 'POST',
        headers: {
          'content-type': 'text/plain; charset=utf-8',
          'content-length': String(Buffer.byteLength(text)),
          authorization: `Bearer ${token}`,
        },
        timeout: REQUEST_TIMEOUT_MS,
      },
      (res) => {
        const chunks = []
        res.on('data', (chunk) => chunks.push(Buffer.from(chunk)))
        res.on('end', () => resolve({ status: res.statusCode ?? 0, body: Buffer.concat(chunks).toString('utf8') }))
        res.on('error', reject)
      },
    )
    req.on('timeout', () => {
      req.destroy(new Error(`no answer from ${HOST}:${port} in ${REQUEST_TIMEOUT_MS / 1000} s`))
    })
    req.on('error', reject)
    req.end(Buffer.from(text, 'utf8'))
  })
}

async function main() {
  const token = (process.env.DSHBOT_NOTIFY_TOKEN ?? '').trim()
  const portRaw = (process.env.DSHBOT_NOTIFY_PORT ?? '').trim()
  if (token === '') {
    throw new Error('DSHBOT_NOTIFY_TOKEN is not set')
  }
  if (portRaw === '') {
    throw new Error('DSHBOT_NOTIFY_PORT is not set')
  }
  const port = Number(portRaw)
  if (!Number.isSafeInteger(port) || port < 1 || port > 65535) {
    throw new Error(`DSHBOT_NOTIFY_PORT is not a TCP port: ${JSON.stringify(portRaw)}`)
  }

  const args = process.argv.slice(2)
  const text = args.length > 0 ? textFromArgs(args) : await readStdin()

  const answer = await post(port, token, text)
  if (answer.status !== 200) {
    const detail = answer.body.trim()
    const shown = detail.length > 500 ? `${detail.slice(0, 500)}…` : detail
    throw new Error(`/notify answered ${answer.status}${shown === '' ? '' : `: ${shown}`}`)
  }
}

main().catch((error) => {
  fail(error instanceof Error ? error.message : String(error))
})
